{
  "name": "noisemap-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace root for noisemap — a codebase noise analyzer",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter code-noisemap build",
    "dev": "pnpm --filter code-noisemap dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.18.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "code-noisemap": "workspace:*",
    "eslint": "^10.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
